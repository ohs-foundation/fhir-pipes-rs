{
  "resourceType": "StructureDefinition",
  "id": "dhis2-indicator",
  "url": "https://icr.healthcampaigns.org/StructureDefinition/dhis2-indicator",
  "name": "Dhis2Indicator",
  "title": "DHIS2 Indicator",
  "status": "draft",
  "experimental": false,
  "description": "How DHIS2 computes the indicator a Measure was imported from (`kiln dhis2 measures`): the indicator type's factor (100 for a percent, 1 for a plain number, 1000 for a rate per thousand), the type's name, whether the value is annualised, and the decimals DHIS2 displays. The reports' measureScore is the DHIS2 value divided by this factor, so multiply by it to show the figure as DHIS2 does.",
  "fhirVersion": "4.0.1",
  "kind": "complex-type",
  "abstract": false,
  "context": [
    {
      "expression": "Measure",
      "type": "element"
    }
  ],
  "type": "Extension",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Extension",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Extension",
        "path": "Extension",
        "short": "DHIS2 Indicator",
        "definition": "How DHIS2 computes the indicator a Measure was imported from (`kiln dhis2 measures`): the indicator type's factor (100 for a percent, 1 for a plain number, 1000 for a rate per thousand), the type's name, whether the value is annualised, and the decimals DHIS2 displays. The reports' measureScore is the DHIS2 value divided by this factor, so multiply by it to show the figure as DHIS2 does."
      },
      {
        "id": "Extension.extension",
        "path": "Extension.extension",
        "min": 1
      },
      {
        "id": "Extension.extension:factor",
        "path": "Extension.extension",
        "sliceName": "factor",
        "short": "DHIS2 indicator type factor: value = numerator ÷ denominator × factor",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:factor.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:factor.url",
        "path": "Extension.extension.url",
        "fixedUri": "factor"
      },
      {
        "id": "Extension.extension:factor.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "decimal"
          }
        ]
      },
      {
        "id": "Extension.extension:indicatorType",
        "path": "Extension.extension",
        "sliceName": "indicatorType",
        "short": "DHIS2 indicator type name, e.g. Per cent",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:indicatorType.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:indicatorType.url",
        "path": "Extension.extension.url",
        "fixedUri": "indicatorType"
      },
      {
        "id": "Extension.extension:indicatorType.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "string"
          }
        ]
      },
      {
        "id": "Extension.extension:annualized",
        "path": "Extension.extension",
        "sliceName": "annualized",
        "short": "DHIS2 scales the value to a year for periods shorter than a year",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:annualized.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:annualized.url",
        "path": "Extension.extension.url",
        "fixedUri": "annualized"
      },
      {
        "id": "Extension.extension:annualized.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "boolean"
          }
        ]
      },
      {
        "id": "Extension.extension:decimals",
        "path": "Extension.extension",
        "sliceName": "decimals",
        "short": "Decimals DHIS2 displays",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:decimals.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:decimals.url",
        "path": "Extension.extension.url",
        "fixedUri": "decimals"
      },
      {
        "id": "Extension.extension:decimals.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "integer"
          }
        ]
      },
      {
        "id": "Extension.url",
        "path": "Extension.url",
        "fixedUri": "https://icr.healthcampaigns.org/StructureDefinition/dhis2-indicator"
      },
      {
        "id": "Extension.value[x]",
        "path": "Extension.value[x]",
        "max": "0"
      }
    ]
  }
}
